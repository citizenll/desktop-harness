{
  "name": "dsh-desktop",
  "version": "0.1.2",
  "description": "A cross-platform desktop shell for DeepSeek Harness.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "desktopName": "io.dsh.desktop.desktop",
  "author": "DataElement",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citizenll/desktop-harness.git"
  },
  "bugs": {
    "url": "https://github.com/citizenll/desktop-harness/issues"
  },
  "homepage": "https://github.com/citizenll/desktop-harness#readme",
  "keywords": [
    "deepseek",
    "harness",
    "electron",
    "desktop",
    "agent"
  ],
  "scripts": {
    "postinstall": "patch-package && node scripts/install-brand-assets.mjs && install-electron --no",
    "dev": "electron-vite dev",
    "build": "npm run verifier:build && electron-vite build",
    "market:build": "npm --prefix packages/dsh-desktop-market run build:client",
    "verifier:build": "npm --prefix packages/dsh-desktop-verifier run build",
    "build:runtime": "npm run build && npm run runtime:stage",
    "runtime:stage": "node scripts/prepare-runtime.mjs",
    "core:stage": "npm run verifier:build && node scripts/prepare-core-runtime.mjs --stage-only",
    "core:package": "npm run verifier:build && node scripts/prepare-core-runtime.mjs",
    "core:package-staged": "node scripts/prepare-core-runtime.mjs --package-only",
    "core:verify-reproducible": "node scripts/verify-core-reproducibility.mjs",
    "core:baseline:published": "node scripts/prepare-published-core-baseline.mjs",
    "core:key:generate": "node scripts/generate-core-signing-key.mjs",
    "runtime:verify": "node scripts/verify-packaged-runtime.mjs dist",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "preview": "electron-vite preview",
    "typecheck:host": "tsc --noEmit -p tsconfig.host.json",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && npm --prefix packages/dsh-desktop-market run typecheck:client && npm --prefix packages/dsh-desktop-verifier run typecheck",
    "check:dsh": "node scripts/check-dsh-release-train.mjs",
    "test": "npm run check:dsh && vitest run",
    "test:watch": "vitest",
    "package:dir": "npm run build:runtime && electron-builder --dir --projectDir .runtime --config ../electron-builder.staged.cjs && npm run runtime:verify",
    "package:dev:dir": "npm run build:runtime && electron-builder --dir --projectDir .runtime --config ../electron-builder.dev.cjs && node scripts/verify-packaged-runtime.mjs dist-dev",
    "package:dev:win": "node scripts/verify-target.mjs win32 x64 && npm run build:runtime && electron-builder --win --x64 --publish never --projectDir .runtime --config ../electron-builder.dev.cjs && node scripts/verify-packaged-runtime.mjs dist-dev",
    "package:mac": "npm run build:runtime && electron-builder --mac --publish never --projectDir .runtime --config ../electron-builder.staged.cjs && npm run runtime:verify",
    "package:mac:arm64": "node scripts/verify-target.mjs darwin arm64 && npm run build:runtime && electron-builder --mac --arm64 --publish never --projectDir .runtime --config ../electron-builder.staged.cjs && npm run runtime:verify",
    "package:mac:x64": "node scripts/verify-target.mjs darwin x64 && npm run build:runtime && electron-builder --mac --x64 --publish never --projectDir .runtime --config ../electron-builder.staged.cjs && npm run runtime:verify",
    "package:win": "node scripts/verify-target.mjs win32 x64 && npm run build:runtime && electron-builder --win --x64 --publish never --projectDir .runtime --config ../electron-builder.staged.cjs && npm run runtime:verify",
    "package:linux": "node scripts/verify-target.mjs linux x64 && npm run build:runtime && electron-builder --linux --x64 --publish never --projectDir .runtime --config ../electron-builder.staged.cjs && npm run runtime:verify"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.1",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.1",
    "@deepseek-ai/dsh-authorization": "0.1.1-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.1.1-rc.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.1",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.1",
    "@deepseek-ai/dsh-output-retention": "0.1.1-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "0.1.1-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "0.1.1-rc.1",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.1",
    "@deepseek-ai/dsh-spill": "0.1.1-rc.1",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.1-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.1",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.1",
    "dsh-desktop-market": "file:packages/dsh-desktop-market",
    "dsh-desktop-plugin-runtime": "file:packages/dsh-desktop-plugin-runtime",
    "dsh-desktop-verifier": "file:packages/dsh-desktop-verifier",
    "pnpm": "10.34.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "5.0.0",
    "lightningcss": "1.33.0",
    "node": "22.23.2",
    "patch-package": "^8.0.1",
    "qrcode": "^1.5.4",
    "tar": "7.5.22",
    "tsdown": "0.21.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "^4.1.10",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "koffi": "3.1.5"
  },
  "build": {
    "appId": "io.dsh.desktop",
    "productName": "DSH Desktop",
    "protocols": [
      {
        "name": "DSH Desktop Plugin Installer",
        "schemes": [
          "dsh-desktop"
        ]
      }
    ],
    "asar": {
      "smartUnpack": false
    },
    "npmRebuild": false,
    "compression": "normal",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW"
    ],
    "directories": {
      "app": ".runtime",
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "citizenll",
        "repo": "desktop-harness"
      }
    ],
    "artifactName": "dsh-desktop-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": ".core-runtime/distribution/core-runner",
          "to": "core-runner",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": ".core-runtime/distribution/core-baseline",
          "to": "core-baseline",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "format": "UDBZ"
    },
    "win": {
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false,
      "extraResources": [
        {
          "from": ".core-runtime/distribution/core-runner",
          "to": "core-runner",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": ".core-runtime/distribution/core-baseline",
          "to": "core-baseline",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "build/dsh-cli",
          "to": "dsh-cli",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "citizenll",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": ".core-runtime/distribution/core-runner",
          "to": "core-runner",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": ".core-runtime/distribution/core-baseline",
          "to": "core-baseline",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "dsh-desktop-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "dsh-desktop-linux-x64.${ext}"
    },
    "nsis": {
      "artifactName": "dsh-desktop-windows-${arch}-setup.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
